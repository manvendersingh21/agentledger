# AgentLedger environment. Copy to .env.local and fill in values. Never commit real secrets.

# --- Supabase (from `pnpm exec supabase status` locally, or the project dashboard) ---
# API URL, e.g. http://127.0.0.1:54321 for the local stack
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key; safe for the browser, RLS-restricted
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key; SERVER ONLY. Bypasses RLS; used for privileged writes after the server authenticates the user
SUPABASE_SECRET_KEY=

# --- App ---
# Public base URL of the app (used for OAuth protected-resource metadata and MCP), e.g. http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=
# "true" enables the demo reset button / demo login hints. Leave empty or "false" outside local demos
NEXT_PUBLIC_DEMO_MODE=

# --- Payments ---
# stripe | demo. "stripe" (default) uses Stripe test mode; "demo" is a clearly-labelled local provider
PAYMENT_PROVIDER=
# Stripe TEST secret key only (sk_test_... or rk_test_...). Live keys are refused by the provider
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (optional; reserved for webhook verification)
STRIPE_WEBHOOK_SECRET=

# --- Agent (playground) ---
# OpenAI API key for the playground agent (Responses API via the Vercel AI SDK). Without it the playground is disabled
OPENAI_API_KEY=
# Agent provider name (currently only "openai" is implemented)
AGENT_PROVIDER=
# Model id for the agent; defaults to gpt-5.4-mini
AGENT_MODEL=

# --- Guardrail signals ---
# Jev (TypeSafe System One) API key; server only. Missing/failed Jev => escalate to human approval
JEV_API_KEY=
# ScamAdvisor API key (optional). Without it, merchants use stored scores labelled "fixture"
SCAMADVISOR_API_KEY=
# ScamAdvisor endpoint override (optional; defaults to https://api.scamadviser.com/v2/trust)
SCAMADVISOR_API_URL=
